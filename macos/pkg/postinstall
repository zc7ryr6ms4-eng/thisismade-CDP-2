#!/bin/bash
# thisismade cdp-2 – postinstall (läuft als root im macOS-Installer)
# 1. installiert bei Bedarf Apples Command Line Tools (Swift-Compiler)
# 2. kompiliert die App aus dem mitgelieferten Quellcode
# 3. legt sie nach /Applications
set -u
APP_NAME="thisismade cdp-2"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WORK="$(mktemp -d /private/tmp/thisismade-build.XXXXXX)"
LOG="/private/tmp/thisismade-cdp-2-install.log"
exec > >(tee "$LOG") 2>&1
export HOME="$WORK/home" TMPDIR="$WORK/tmp"
mkdir -p "$HOME" "$TMPDIR"

echo "== thisismade cdp-2: Installation $(date)"
sw_vers

have_swift() { /usr/bin/xcrun --find swiftc >/dev/null 2>&1; }

if ! have_swift; then
  echo "== Command Line Tools fehlen – werden über die Softwareaktualisierung installiert"
  FLAG=/private/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
  touch "$FLAG"
  LABEL="$(/usr/sbin/softwareupdate -l 2>/dev/null | grep -B 1 -E 'Command Line Tools' \
          | awk -F'*' '/^ *\*/ {print $2}' | sed -e 's/^ *Label: //' -e 's/^ *//' | sort -V | tail -n1)"
  if [ -n "$LABEL" ]; then
    echo "== Installiere: $LABEL"
    /usr/sbin/softwareupdate -i "$LABEL" --verbose
  fi
  rm -f "$FLAG"
  [ -d /Library/Developer/CommandLineTools ] && /usr/bin/xcode-select --switch /Library/Developer/CommandLineTools
fi

if ! have_swift; then
  echo "!! Swift-Compiler nicht verfügbar. Bitte im Terminal 'xcode-select --install' ausführen"
  echo "!! und das Installationspaket danach erneut öffnen."
  exit 1
fi

echo "== Kompiliere"
cp -R "$SCRIPT_DIR/src" "$WORK/macos"
chmod +x "$WORK/macos/build.sh"
if ! /bin/bash "$WORK/macos/build.sh"; then
  echo "!! Kompilieren fehlgeschlagen – Protokoll: $LOG"
  exit 1
fi

echo "== Installiere nach /Applications"
rm -rf "/Applications/$APP_NAME.app"
cp -R "$WORK/macos/build/$APP_NAME.app" /Applications/
chown -R root:admin "/Applications/$APP_NAME.app"
chmod -R go-w "/Applications/$APP_NAME.app"
xattr -dr com.apple.quarantine "/Applications/$APP_NAME.app" 2>/dev/null || true
rm -rf "$WORK"

# Für den angemeldeten Benutzer starten
USER_NAME="$(/usr/bin/stat -f%Su /dev/console)"
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ]; then
  USER_ID="$(/usr/bin/id -u "$USER_NAME")"
  /bin/launchctl asuser "$USER_ID" /usr/bin/sudo -u "$USER_NAME" /usr/bin/open "/Applications/$APP_NAME.app" || true
fi
echo "== Fertig"
exit 0
